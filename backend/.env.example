FLASK_ENV=development
SECRET_KEY=change-me-to-a-long-random-secret
DATABASE_URL=sqlite:///novelwiki.db
UPLOAD_FOLDER=instance/uploads
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SESSION_COOKIE_SAMESITE=Lax
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# For AI_PROVIDER=openrouter, these providers are tried first in order.
# OpenRouter may use other providers if all three fail.
OPENROUTER_PROVIDER_ORDER=atlas-cloud,alibaba,baidu
OPENROUTER_ALLOW_FALLBACKS=true
AI_EXTRACTION_PIPELINE=legacy
AI_PARALLEL_SAFE_STAGES=false
AI_MAX_CONCURRENT_STAGES=3
AI_CONDITIONAL_PROGRESSION_STAGES=false
AI_REQUEST_TIMEOUT=150
AI_CONNECT_TIMEOUT=10
AI_READ_TIMEOUT=150
AI_STAGE_HARD_TIMEOUT=180
AI_STAGE_HEARTBEAT_INTERVAL=30
AI_STAGE_MAX_RETRIES=1
GPT_REVIEW_ENABLED=false
GPT_REVIEW_MODEL=gpt-5.5
GPT_REVIEW_MAX_CANDIDATES=25
GPT_REVIEW_DRY_RUN=true
GPT_REVIEW_API_KEY=
